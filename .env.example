# ============================================
# Our Space — Environment Configuration
# ============================================
# Copy this file to .env and fill in all values
# cp .env.example .env
# ============================================

# Application environment: "production" or "development"
NODE_ENV=production

# Port the Express server listens on (Nginx proxies to this)
PORT=3001

# Secret key for signing JWT access tokens (generate a random 64-char string)
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Secret key for signing JWT refresh tokens (use a DIFFERENT random 64-char string)
JWT_REFRESH_SECRET=

# Absolute path to the SQLite database file (OUTSIDE the app directory)
DB_PATH=/var/data/ourspace/ourspace.db

# Absolute path to the uploads directory (OUTSIDE the app directory)
UPLOADS_PATH=/var/data/ourspace/uploads

# Frontend origin for CORS (your domain with protocol, no trailing slash)
# In development: http://localhost:5173
# In production: https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com
