# ============================================
# Our Space — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================

# Application environment ("production" or "development")
NODE_ENV=production

# Server Port (cPanel Phusion Passenger sets this automatically, but default is 3001)
PORT=3001

# Secret key for JWT access tokens (generate random 64-char string)
# Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Secret key for JWT refresh tokens (generate a DIFFERENT random 64-char string)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Frontend origin for CORS (your domain, e.g. https://ourverse.my.id)
CORS_ORIGIN=https://yourdomain.com

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# Recommended: Neon (https://neon.tech) — Free serverless PostgreSQL
# Or your existing Vercel Postgres / Supabase connection string.
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Alternative variable name:
# POSTGRES_URL=postgresql://...

# ============================================
# Storage / Media Uploads (cPanel Local Storage)
# ============================================
# By default on cPanel, uploads are saved locally in the app's ./uploads folder.
# You can leave UPLOADS_PATH empty to use the default ./uploads directory,
# or specify an absolute path (e.g. /home/username/ourspace/uploads)
UPLOADS_PATH=

# (Optional) If you prefer to continue using Vercel Blob for storage:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ============================================
# Push Notifications (Web Push / VAPID) - Optional
# ============================================
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com
